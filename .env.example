# Application
APP_NAME=DocParse
APP_VERSION=1.0.0
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8898

# ASGI reverse-proxy metadata. Leave empty for direct local access.
ROOT_PATH=

# Comma-separated browser origins. Do not use * for an Internet-facing service.
CORS_ORIGINS=http://localhost:3000

# LLM provider (required for classification and generated abstracts)
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.6-flash
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# Alibaba Cloud Document Mind (required for the preferred PDF/Word path)
DOCMIND_ACCESS_KEY_ID=
DOCMIND_ACCESS_KEY_SECRET=
DOCMIND_ENDPOINT=docmind-api.cn-hangzhou.aliyuncs.com
DOCMIND_POLL_INTERVAL=3
DOCMIND_TIMEOUT=300
DOCMIND_MAX_CONCURRENT=1

# Asynchronous task storage and lifecycle
TASK_STORAGE_DIR=
TASK_EXECUTOR_WORKERS=4
TASK_TIMEOUT=3000
TASK_STUCK_TIMEOUT=600
TASK_MAX_AGE_HOURS=24
TASK_WATCHDOG_INTERVAL=60

# Gunicorn
GUNICORN_BIND=0.0.0.0:8898
GUNICORN_WORKERS=4
GUNICORN_LOG_LEVEL=info
